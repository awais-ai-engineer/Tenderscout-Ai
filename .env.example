POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tenderscout
POSTGRES_USER=tenderscout
POSTGRES_PASSWORD=replace-with-a-local-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Explicit browser origins, as a JSON array. No wildcard or trailing slash.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Set when connecting to an authenticated Redis deployment.
# REDIS_PASSWORD=

DOCUMENT_STORAGE_DIR=.data/documents
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_MAX_PAGES=500

# Required only for AI calls. Choose a model with Responses structured-output support.
# OPENAI_API_KEY=
# AI_MODEL=
AI_MAX_INPUT_CHARS=60000

# RAG uses a separate embedding model; choose one supporting dimensions=1536.
# AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE_CHARS=2000
RAG_CHUNK_OVERLAP_CHARS=250
RAG_EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000

# Defaults to a safely escaped URL built from REDIS_*; optional secret overrides.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
# 0 disables a schedule; enabled schedules must be at least 15 minutes.
FIND_A_TENDER_SCHEDULE_MINUTES=15
CONTRACTS_FINDER_SCHEDULE_MINUTES=15
TED_SCHEDULE_MINUTES=30
WORLD_BANK_SCHEDULE_MINUTES=30
AUTO_MATCH_ENABLED=true
AUTO_MATCH_MAX_COMPANIES=100

# Optional transactional email. Without SMTP_HOST/FROM, alerts remain in-app.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=mailer
# SMTP_PASSWORD=replace-me
# SMTP_FROM_EMAIL=alerts@example.com
SMTP_STARTTLS=true
PRODUCT_BASE_URL=http://localhost:3000
DAILY_DIGEST_HOUR_UTC=8
DEADLINE_REMINDER_DAYS=[7,2]
PIPELINE_STALE_AFTER_MINUTES=60
PIPELINE_MAX_TENDERS=100
PIPELINE_MAX_DOCUMENTS=100
